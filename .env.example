# ==================== REQUIRED ====================

# Neon PostgreSQL (get from https://console.neon.tech)
# Use the connection string from Neon (pooled or direct both work)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# App URL (your Vercel deployment URL, no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Generate a long random string (e.g. openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# ==================== EMAIL (Resend) ====================
# Get API key from https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain or the default onboarding address for testing
RESEND_FROM_EMAIL="GreenRise Expo <onboarding@resend.dev>"
RESEND_FROM_NAME="GreenRise Expo"

# ==================== OPTIONAL ====================

# Image storage (Cloudinary example - or replace with Uploadthing / Vercel Blob)
IMAGE_STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==================== NOTES ====================
# 1. Never commit real .env files or secrets to GitHub.
# 2. Add all variables in Vercel Dashboard → Project → Settings → Environment Variables.
# 3. After first deploy, visit /setup to create the Super Admin account.
# 4. Only DATABASE_URL is required for the database (DATABASE_URL_UNPOOLED is no longer needed).
